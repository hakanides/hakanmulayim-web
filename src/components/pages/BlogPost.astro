---
import { render, type CollectionEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { formatDate } from '../../lib/date';
import { useTranslations, type Lang } from '../../i18n/ui';
import 'katex/dist/katex.min.css';

interface Props { entry: CollectionEntry<'blog'>; lang: Lang; altPath?: string }
const { entry, lang, altPath } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const backHref = lang === 'tr' ? '/blog' : '/en/blog';
const eyebrow = [formatDate(entry.data.date, lang), ...entry.data.tags].join(' · ');
---
<Page title={entry.data.title} description={entry.data.description} lang={lang} altPath={altPath} intro={entry.data.description} eyebrow={eyebrow} banner="/img/banner-blog.jpg" bannerPosition="center 45%" bannerOverlay={0.5}>
  <a href={backHref} class="text-sm underline underline-offset-4">← {t('blog.title')}</a>
  <div class="prose-body mt-8">
    <Content />
  </div>
</Page>
