---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/date';
import { useTranslations, type Lang } from '../../i18n/ui';
import 'katex/dist/katex.min.css';

interface Props { entry: CollectionEntry<'notes'>; lang: Lang; altPath?: string }
const { entry, lang, altPath } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const backHref = lang === 'tr' ? '/ders-notlari' : '/en/notes';
---
<Base title={entry.data.title} description={entry.data.description} lang={lang} altPath={altPath}>
  <main class="w-full max-w-2xl mx-auto px-5 py-12 sm:py-16">
  <a href={backHref} class="text-sm underline underline-offset-4">← {t('notes.title')}</a>
  <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
    <span class="px-1.5 py-0.5 border border-gray-300 dark:border-gray-700 text-xs font-medium">
      {entry.data.category}
    </span>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
  </div>
  <h1 class="mt-2 text-4xl">{entry.data.title}</h1>
  {entry.data.pdf && (
    <a href={entry.data.pdf} download
      class="mt-4 inline-block px-4 py-2 border border-ink dark:border-gray-100 text-sm font-medium hover:bg-ink hover:text-white dark:hover:bg-gray-100 dark:hover:text-ink transition-colors">
      {t('notes.download')}
    </a>
  )}
  <div class="prose-body mt-6">
    <Content />
  </div>
  </main>
</Base>
