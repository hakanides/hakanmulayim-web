---
import Page from '../../layouts/Page.astro';
import { teaching } from '../../data/teaching';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const d = teaching[lang];
const contactHref = lang === 'tr' ? '/iletisim' : '/en/contact';
---
<Page title={t('teaching.title')} description={d.intro} lang={lang} intro={d.intro}>
  <section class="mt-10">
    <h2 class="section-title">{d.approachHeading}</h2>
    <p class="mt-3 leading-relaxed">{d.approach}</p>
  </section>

  <section class="mt-12">
    <h2 class="section-title">{d.universityHeading}</h2>
    <ul class="space-y-5">
      {d.university.map((u) => (
        <li class="sm:grid sm:grid-cols-[8.5rem_1fr] sm:gap-4">
          <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 sm:pt-0.5">{u.period}</p>
          <div><p class="font-medium">{u.course}</p><p class="text-sm text-gray-600 dark:text-gray-300">{u.detail}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="section-title">{d.villageHeading}</h2>
    <ul class="space-y-5">
      {d.village.map((v) => (
        <li class="sm:grid sm:grid-cols-[8.5rem_1fr] sm:gap-4">
          <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 sm:pt-0.5">{v.period}</p>
          <div><p class="font-medium">{v.role}</p><p class="text-sm text-gray-600 dark:text-gray-300">{v.detail}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="section-title">{d.examsHeading}</h2>
    <p class="mt-2 text-gray-600 dark:text-gray-400">{d.examsIntro}</p>
    <div class="mt-5 grid gap-6 sm:grid-cols-2">
      {d.exams.map((g) => (
        <div>
          <h3 class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{g.group}</h3>
          <ul class="mt-2 space-y-1">{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
    <a href={contactHref} class="inline-block mt-8 px-4 py-2 border border-ink dark:border-gray-100 text-sm font-medium hover:bg-ink hover:text-white dark:hover:bg-gray-100 dark:hover:text-ink transition-colors">
      {d.cta}
    </a>
  </section>
</Page>
