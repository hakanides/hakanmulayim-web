---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/date';
import { slugOf } from '../lib/content';
import type { Lang } from '../i18n/ui';

interface Props { entry: CollectionEntry<'notes'>; lang: Lang }
const { entry, lang } = Astro.props;
const href = (lang === 'tr' ? '/ders-notlari/' : '/en/notes/') + slugOf(entry);
---
<article data-note-card data-category={entry.data.category} class="py-4 border-b border-gray-200 dark:border-gray-800">
  <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
    <span class="px-1.5 py-0.5 border border-gray-300 dark:border-gray-700 text-xs font-medium">
      {entry.data.category}
    </span>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
  </div>
  <h3 class="mt-1 font-serif text-xl">
    <a href={href} class="hover:underline underline-offset-4">{entry.data.title}</a>
  </h3>
  <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{entry.data.description}</p>
</article>
