---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; altPath: string }
const { lang, altPath } = Astro.props;
const t = useTranslations(lang);

const links: [string, string][] =
  lang === 'tr'
    ? [
        ['/', t('nav.home')],
        ['/cv', t('nav.cv')],
        ['/arastirma', t('nav.research')],
        ['/ogretim', t('nav.teaching')],
        ['/ders-notlari', t('nav.notes')],
        ['/blog', t('nav.blog')],
        ['/etkinlikler', t('nav.events')],
        ['/iletisim', t('nav.contact')],
      ]
    : [
        ['/en/', t('nav.home')],
        ['/en/cv', t('nav.cv')],
        ['/en/research', t('nav.research')],
        ['/en/teaching', t('nav.teaching')],
        ['/en/notes', t('nav.notes')],
        ['/en/blog', t('nav.blog')],
        ['/en/events', t('nav.events')],
        ['/en/contact', t('nav.contact')],
      ];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/' || h === '/en') return current === h;
  return current === h || current.startsWith(h + '/');
};
---
<header class="absolute inset-x-0 top-0 z-10 text-white">
  <div class="max-w-5xl mx-auto px-5 py-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
    <a href={lang === 'tr' ? '/' : '/en/'} class="font-serif text-lg tracking-tight mr-auto">hakan mülayim</a>
    <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label={lang === 'tr' ? 'Site menüsü' : 'Site menu'}>
      {links.map(([href, label]) => (
        <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}
          class="text-white/75 hover:text-white aria-[current=page]:text-white aria-[current=page]:underline underline-offset-[6px] decoration-1">
          {label}
        </a>
      ))}
    </nav>
    <a href={altPath} class="px-2.5 py-1 text-xs font-medium tracking-wide border border-white/60 text-white/90 hover:bg-white hover:text-ink transition-colors"
      aria-label={lang === 'tr' ? 'Switch to English' : 'Türkçeye geç'}>
      {lang === 'tr' ? 'EN' : 'TR'}
    </a>
  </div>
</header>
