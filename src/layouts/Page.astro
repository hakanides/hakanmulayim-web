---
/** İç sayfa kabuğu: fotoğraflı banner (başlık + giriş), altında dar içerik sütunu. */
import Base from './Base.astro';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  altPath?: string;
  intro?: string;
  /** Başlığın üstünde küçük büyük harfli satır (ör. kategori · tarih) */
  eyebrow?: string;
}
const { title, description, lang, altPath, intro, eyebrow } = Astro.props;
const bannerStyle = profile.heroImage ? `background-image:url('${profile.heroImage}')` : undefined;
---
<Base title={title} description={description} lang={lang} altPath={altPath}>
  <section class="relative bg-ink bg-cover bg-center text-white" style={bannerStyle}>
    {profile.heroImage && <div class="absolute inset-0 bg-black/60" aria-hidden="true"></div>}
    <div class="relative max-w-2xl mx-auto px-5 pt-32 pb-14 sm:pt-40 sm:pb-20">
      {eyebrow && <p class="text-xs uppercase tracking-widest text-white/70">{eyebrow}</p>}
      <h1 class="mt-2 text-4xl sm:text-5xl tracking-tight">{title}</h1>
      {intro && <p class="mt-4 max-w-xl text-white/80 leading-relaxed">{intro}</p>}
    </div>
  </section>
  <main class="w-full max-w-2xl mx-auto px-5 py-12 sm:py-16">
    <slot />
  </main>
</Base>
