---
/** İç sayfa kabuğu: başlık, isteğe bağlı giriş metni, dar sütun. */
import Base from './Base.astro';
import type { Lang } from '../i18n/ui';

interface Props { title: string; description: string; lang: Lang; altPath?: string; intro?: string }
const { title, description, lang, altPath, intro } = Astro.props;
---
<Base title={title} description={description} lang={lang} altPath={altPath}>
  <main class="w-full max-w-2xl mx-auto px-5 py-12 sm:py-16">
    <h1 class="text-4xl">{title}</h1>
    {intro && <p class="mt-3 text-gray-600 dark:text-gray-400">{intro}</p>}
    <slot />
  </main>
</Base>
