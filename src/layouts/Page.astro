---
/** İç sayfa kabuğu: fotoğraflı banner (başlık + giriş), altında dar içerik sütunu. */
import Base from './Base.astro';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  altPath?: string;
  intro?: string;
  /** Başlığın üstünde küçük büyük harfli satır (ör. kategori · tarih) */
  eyebrow?: string;
  /** Sayfaya özel banner görseli; verilmezse ana sayfa hero görseli kullanılır */
  banner?: string;
  /** CSS background-position (ör. 'center top'); varsayılan 'center' */
  bannerPosition?: string;
  /** Koyu kaplama yoğunluğu 0–1; koyu fotoğraflarda düşürün. Varsayılan 0.6 */
  bannerOverlay?: number;
  /** Büyük ekranda banner yüksekliği sınıfı; varsayılan 'lg:min-h-[30vw]' */
  bannerHeight?: string;
}
const { title, description, lang, altPath, intro, eyebrow, banner, bannerPosition = 'center', bannerOverlay = 0.6, bannerHeight = 'lg:min-h-[30vw]' } = Astro.props;
const image = banner || profile.heroImage;
const bannerStyle = image ? `background-image:url('${image}');background-position:${bannerPosition}` : undefined;
---
<Base title={title} description={description} lang={lang} altPath={altPath}>
  <section class={`relative bg-ink bg-cover text-white lg:flex lg:items-center ${bannerHeight}`} style={bannerStyle}>
    {image && <div class="absolute inset-0 bg-black" style={`opacity:${bannerOverlay}`} aria-hidden="true"></div>}
    <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/60 to-transparent" aria-hidden="true"></div>
    <div class="relative w-full max-w-2xl mx-auto px-5 pt-44 pb-14 sm:pt-40 sm:pb-20 lg:pt-32 lg:pb-16">
      {eyebrow && <p class="text-xs uppercase tracking-widest text-white/70">{eyebrow}</p>}
      <h1 class="mt-2 text-4xl sm:text-5xl tracking-tight">{title}</h1>
      {intro && <p class="mt-4 max-w-xl text-white/80 leading-relaxed">{intro}</p>}
    </div>
  </section>
  <main class="w-full max-w-2xl mx-auto px-5 py-12 sm:py-16">
    <slot />
  </main>
</Base>
