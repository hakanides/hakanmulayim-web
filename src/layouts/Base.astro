---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAlternatePath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  altPath?: string;
  /** Ana sayfa: menü hero fotoğrafının üstüne şeffaf biner */
  overlayHeader?: boolean;
}
const { title, description, lang, altPath, overlayHeader = false } = Astro.props;

const path = Astro.url.pathname;
const alternate = altPath ?? getAlternatePath(path);
const site = Astro.site!.origin;
const trUrl = lang === 'tr' ? site + path : site + alternate;
const enUrl = lang === 'en' ? site + path : site + alternate;
const pageTitle = title === 'Hakan Mülayim' ? title : `${title} — Hakan Mülayim`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={site + path} />
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={trUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site + path} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink dark:bg-ink dark:text-gray-100 antialiased">
    <div class="relative flex-1 flex flex-col">
      <Header lang={lang} altPath={alternate} overlay={overlayHeader} />
      <slot />
    </div>
    <Footer />
  </body>
</html>
